APP_ENV=development
RAG_RUNTIME_MODE=real
APP_HOST=127.0.0.1
APP_PORT=8001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

METADATA_STORE=mysql
DATABASE_URL=mysql://livedoc:livedoc_dev_password@127.0.0.1:3307/livedoc_nest

VECTOR_STORE=qdrant
QDRANT_URL=http://127.0.0.1:6335
QDRANT_API_KEY=
QDRANT_COLLECTION=article_chunks_real_v1

EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
EMBEDDING_DIM=512
CHUNK_MAX_TOKENS=420
CHUNK_OVERLAP_TOKENS=64
SPARSE_EMBEDDING_PROVIDER=qdrant_idf
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANK_PROVIDER=bge
RERANK_MODEL=Xenova/bge-reranker-base
MODEL_DTYPE=q8
MODEL_CACHE_DIR=data/model_cache
INFERENCE_REQUEST_TIMEOUT_SECONDS=180
INFERENCE_MAX_PENDING=32
SIMILARITY_THRESHOLD=0.15
RAG_TOP_K=5
RERANK_TOP_N=10

AGENT_TOOL_SELECTION=llm
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_VARIANTS=3
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_WINDOW=32768
SUMMARY_MAX_OUTPUT_TOKENS=2048
SUMMARY_SAFETY_RATIO=0.15
SUMMARY_MAP_INPUT_TOKENS=6000
# OpenAI-compatible vendor extensions used only for Function Call requests.
# Alibaba Model Studio Qwen thinking models require: {"enable_thinking":false}
LLM_TOOL_CALL_EXTRA_BODY={}

MEMORY_STORE=mysql
MEMORY_MAX_MESSAGES=12
MEMORY_MAX_TURNS=6
SHORT_MEMORY_TOKEN_BUDGET=4000
MEMORY_TTL_DAYS=30
DOCUMENT_MEMORY_ENABLED=true
DOCUMENT_MEMORY_TOKEN_BUDGET=500
DOCUMENT_MEMORY_MIN_CONFIDENCE=0.7
DOCUMENT_MEMORY_MAX_ATTEMPTS=3
DOCUMENT_MEMORY_LEASE_SECONDS=300
INDEX_JOB_STORE=mysql
OBSERVABILITY_STORE=mysql
INDEX_WORKER_POLL_SECONDS=1
IMPORT_JOB_STORE=mysql
IMPORT_WORKER_POLL_SECONDS=1
IMPORT_JOB_LEASE_SECONDS=1800
IMPORT_JOB_MAX_ATTEMPTS=3
IMPORT_MAX_UPLOAD_MB=50
IMPORT_RETENTION_DAYS=7
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=data/storage
DOCLING_PYTHON=C:\path\to\python-3.13\python.exe
DOCLING_SCRIPT=scripts/docling_parse.py
DOCLING_NUM_THREADS=1
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=45
INDEX_JOB_LEASE_SECONDS=900
INDEX_JOB_MAX_ATTEMPTS=3
INDEX_JOB_BATCH_SIZE=5
METRICS_RETENTION_DAYS=90

CONTEXT_TOKEN_BUDGET=1500
CONTEXT_PER_CITATION_TOKENS=420
TOKENIZER_ENCODING=cl100k_base

# Document Agent and personal knowledge workspace (see docs/document-agent.md).
DOCUMENT_AGENT_ENABLED=true
WORKSPACE_ENABLED=true
MCP_ENABLED=false
MCP_SERVERS={}
# Optional native DashScope search (returns source links); blank disables it.
# For multimodal Qwen models use the multimodal-generation endpoint for your region.
AGENT_WEB_SEARCH_URL=
AGENT_WEB_SEARCH_MODEL=
AGENT_MAX_TOOL_CALLS=12
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_THINKING_SUPPORTED=false
AGENT_THINKING_ON_BODY={}
AGENT_THINKING_OFF_BODY={}
AGENT_CLASSIFIER_MODEL=
AGENT_PLAN_MODEL=
AGENT_CRITIC_MODEL=
