{
  "name": "livedoc-server-nest",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript/NestJS parity implementation of the LiveDoc RAG backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "predev": "npm run config:check:live",
    "dev": "tsx scripts/dev-all.ts",
    "prestart:dev": "npm run config:check:live",
    "start:dev": "node --enable-source-maps --watch --loader ts-node/esm src/main.ts",
    "preworker": "npm run config:check:live",
    "worker": "node --enable-source-maps --loader ts-node/esm src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "preworker:imports": "npm run config:check:live",
    "worker:imports": "node --enable-source-maps --loader ts-node/esm src/import-worker.ts",
    "worker:imports:prod": "node dist/import-worker.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "validate:evals": "tsx scripts/evaluate-rag.ts --validate-only",
    "db:migrate": "tsx scripts/migrate.ts",
    "memory:backfill": "tsx scripts/backfill-document-memory.ts",
    "qdrant:init": "tsx scripts/init-qdrant.ts",
    "seed:demo": "node --max-old-space-size=4096 --enable-source-maps --loader ts-node/esm scripts/seed-demo.ts",
    "config:check": "tsx scripts/check-config.ts",
    "config:check:live": "tsx scripts/check-config.ts --live",
    "validate:real": "tsx scripts/evaluate-rag.ts --real",
    "validate:e2e:real": "node --max-old-space-size=4096 --enable-source-maps --loader ts-node/esm scripts/validate-real-e2e.ts",
    "diff:contracts": "tsx scripts/contract-diff.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@huggingface/transformers": "^3.7.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@node-rs/jieba": "^2.0.1",
    "@qdrant/js-client-rest": "^1.15.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "js-tiktoken": "^1.0.21",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "murmurhash-js": "^1.0.0",
    "mysql2": "^3.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/murmurhash-js": "^1.0.7",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "yazl": "^3.3.1"
  }
}
