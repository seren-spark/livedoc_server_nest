{
  "name": "livedoc-server-nest",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript/NestJS parity implementation of the LiveDoc RAG backend",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --runInBand",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "validate:evals": "tsx scripts/evaluate-rag.ts --validate-only",
    "diff:contracts": "tsx scripts/contract-diff.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@node-rs/jieba": "^2.0.1",
    "@qdrant/js-client-rest": "^1.15.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "js-tiktoken": "^1.0.21",
    "mysql2": "^3.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
